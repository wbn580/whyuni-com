---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const _ogImageProp = article.data?.ogImage || article.data?.heroImage || article.data?.featured_image || article.data?.featuredImage || article.data?.coverImage || article.data?.image || undefined; /* og-wiring */

---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  publishDate={article.data.publishDate}
  category={article.data.category}
  readingTime={article.data.readingTime}
  ogImage={_ogImageProp}
  sources={article.data.sources}
>
  <Content />
</ArticleLayout>
