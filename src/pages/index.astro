---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => !data.draft);
articles.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const featured = articles.slice(0, 8);
const categories = [
    { slug: 'program-comparison', name: 'Program Comparison', desc: 'Head-to-head program comparisons across universities', icon: '🎓' },
    { slug: 'decision-guides', name: 'Decision Guides', desc: 'Frameworks for making the big call', icon: '🧭' },
    { slug: 'admission-data', name: 'Admission Data', desc: 'Acceptance rates, yield, and historical trends', icon: '📊' },
    { slug: 'career-outcomes', name: 'Career Outcomes', desc: 'Graduate salaries and placement by field', icon: '💼' },
    { slug: 'campus-life', name: 'Campus Life', desc: 'Student experience and culture factors', icon: '🏛️' },
    { slug: 'cost-analysis', name: 'Cost & Aid', desc: 'Tuition and financial aid comparisons', icon: '💰' },
];

const homeSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Why This University',
  url: 'https://whyuni.com',
  description: 'Make informed university choices with data-driven comparisons of programs, admission rates, costs, and outcomes across top universities worldwide.',
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://whyuni.com/?q={{search_term_string}}',
    'query-input': 'required name=search_term_string',
  },
});
---

<BaseLayout
  title="Why This University"
  description="Make informed university choices with data-driven comparisons of programs, admission rates, costs, and outcomes across top universities worldwide."
  schema={homeSchema}
>
  <!-- Hero: centered-overlay warm -->
  <header class="hero">
    <div class="hero-in">
      <span class="eyebrow">Why This University · Decision Guides</span>
      <h1>Choosing where to spend<br><em>four formative years</em></h1>
      <p class="lead">A calm confident guide to the question every applicant agonises over — why this university and not that one. Analytical depth with human reassurance.</p>
      <div class="btns">
        <a href="/category/program-comparison/" class="btn p">Start comparing</a>
        <a href="/category/decision-guides/" class="btn g">Decision guides</a>
      </div>
    </div>
    <div class="cue">Scroll to decide</div>
  </header>

  <!-- Stats bar -->
  <div class="stats">
    <div><div class="n">{articles.length}+</div><div class="l">Articles Published</div></div>
    <div><div class="n">{categories.length}</div><div class="l">Decision Categories</div></div>
    <div><div class="n">100%</div><div class="l">Independent Analysis</div></div>
  </div>

  <!-- Decision bento -->
  <section>
    <div class="wrap">
      <div class="sh">
        <div class="kick">The decision</div>
        <h2>Why this one and not that one</h2>
        <p>We turn the overwhelming choice into a clear comparison — strengths trade-offs and fit, side by side, so the decision feels grounded.</p>
      </div>
      <div class="bento">
        <div class="bx big">
          <div>
            <div class="ic">⚖️</div>
            <h3>Head to head</h3>
            <p>Two universities one decision — strengths weighed across the dimensions that actually matter.</p>
            <div class="vs">
              <div class="o"><div class="nm">Compare</div><div class="sc">→</div></div>
              <div class="x">vs</div>
              <div class="o"><div class="nm">Decide</div><div class="sc">✓</div></div>
            </div>
          </div>
          <a href="/category/program-comparison/" style="color:#f59e0b;font-weight:600;font-size:14px;margin-top:18px">See full comparison →</a>
        </div>
        <a class="bx" href="/category/program-comparison/"><div class="ic">🎓</div><h3>By program</h3><p>Which campus wins for your major.</p></a>
        <a class="bx" href="/category/decision-guides/"><div class="ic">🧭</div><h3>Decision guides</h3><p>Frameworks for the big call.</p></a>
        <a class="bx wide" href="/category/decision-guides/"><div class="ic">💡</div><h3>Fit over prestige</h3><p>Why the highest-ranked option is not always the right one — and how to weigh fit cost and outcomes for you.</p></a>
      </div>
    </div>
  </section>

  <!-- Latest articles -->
  <section style="background:#1e1a14;border-block:1px solid rgba(255,255,255,.09)">
    <div class="wrap">
      <div class="sh">
        <div class="kick">Latest analysis</div>
        <h2>Help making the call</h2>
        <p>Precise never pushy quietly persuasive.</p>
      </div>
      <div class="agrid">
        {featured.map((article, i) => {
          const catSlug = article.data.category?.toLowerCase().replace(/\s+/g, '-') || '';
          return (
            <a class={`ac ${i === 0 ? 'feat' : ''}`} href={`/${article.id}/`}>
              <div class="th">
                <span class="tag">{article.data.category}</span>
                {categories.find(c => c.slug === catSlug)?.icon || '📝'}
              </div>
              <div class="bd">
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
                <div class="m2">Why This University · {article.data.readingTime ? `${article.data.readingTime} min` : ''}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
